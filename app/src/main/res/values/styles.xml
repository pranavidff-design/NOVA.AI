<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Glass-pill button used everywhere instead of Android's default filled button,
         so all of Nova's screens (main, memory, routines) share one premium look. -->
    <style name="NovaButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/nova_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="rippleColor">@color/nova_cyan</item>
    </style>

    <style name="NovaScreenTitle">
        <item name="android:textColor">@color/nova_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
