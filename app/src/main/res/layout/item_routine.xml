<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_panel"
    android:padding="12dp"
    android:layout_marginBottom="10dp">

    <TextView
        android:id="@+id/routineTitleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/nova_text"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/routineActionsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/nova_text_dim"
        android:textSize="12.5sp"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/routineStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/nova_cyan"
        android:textSize="11.5sp"
        android:layout_marginTop="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/routineApproveButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="11sp"
            android:text="Approve" />

        <Button
            android:id="@+id/routineToggleButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="11sp"
            android:text="Disable" />

        <Button
            android:id="@+id/routineRenameButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="11sp"
            android:text="Rename" />

        <Button
            android:id="@+id/routineDeleteButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="11sp"
            android:text="Delete" />

    </LinearLayout>

</LinearLayout>
