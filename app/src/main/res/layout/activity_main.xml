<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_cinematic"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:paddingTop="28dp"
    android:paddingBottom="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="NOVA"
        style="@style/NovaScreenTitle" />

    <!-- The orb: tap to talk. Reacts to state (idle/listening/thinking/speaking/
         wake-active/paused/error) — see NovaOrbView. Sized up + given room to
         glow so it reads as the centerpiece, not a small icon. -->
    <com.nova.assistant.NovaOrbView
        android:id="@+id/orbContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/statusLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/status_idle"
        android:textColor="@color/nova_text_dim"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/memoryButton"
            style="@style/NovaButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Memory" />

        <Button
            android:id="@+id/routinesButton"
            style="@style/NovaButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Routines" />

        <Button
            android:id="@+id/cloudSetupButton"
            style="@style/NovaButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cloud Brain" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal">

        <Button
            android:id="@+id/pauseButton"
            style="@style/NovaButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Pause Nova" />

        <Button
            android:id="@+id/wakeWordButton"
            style="@style/NovaButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Wake word: OFF" />

        <Button
            android:id="@+id/loadModelButton"
            style="@style/NovaButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Load AI Model" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/logScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_panel"
        android:padding="14dp">

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/nova_text"
            android:textSize="13.5sp"
            android:lineSpacingExtra="6dp"
            android:text="Nova is ready." />

    </ScrollView>

</LinearLayout>
